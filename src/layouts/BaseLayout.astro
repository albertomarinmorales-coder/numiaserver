---
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1115" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body class="overflow-x-hidden antialiased">
    <!-- Sky atmosphere: aurora + cloud mist + rising crystal particles -->
    <div class="sky-aurora"    aria-hidden="true"></div>
    <div class="sky-clouds"    aria-hidden="true"></div>
    <div class="sky-particles" aria-hidden="true"></div>

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-arcane focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-void"
    >
      Saltar al contenido
    </a>
    <Navbar />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
