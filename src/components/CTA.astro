---
import RitualButton from "@components/RitualButton.astro";
---

<section class="px-5 py-20 sm:px-8">
  <div class="ritual-border mx-auto max-w-5xl overflow-hidden rounded-[2.4rem] p-8 text-center sm:p-12">
    <p class="font-display text-xs uppercase tracking-[0.44em] text-relic">
      Juramento de permanencia
    </p>
    <h2 class="mx-auto mt-5 max-w-3xl font-display text-4xl text-mist sm:text-5xl">
      La Ciudad vive porque Él permanece.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-stone/82">
      Recorre los libros de la Sociedad y decide si contemplas una verdad sagrada o una
      arquitectura perfecta para domesticar la duda.
    </p>
    <div class="mt-9 flex flex-col justify-center gap-4 sm:flex-row">
      <RitualButton href="/historia">Entrar al archivo</RitualButton>
      <RitualButton href="/dogma" variant="secondary">Invocar el dogma</RitualButton>
    </div>
  </div>
</section>
