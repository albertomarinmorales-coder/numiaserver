---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  align?: "left" | "center";
}

const { eyebrow, title, text, align = "left" } = Astro.props;
---

<div class:list={["mx-auto max-w-3xl", align === "center" && "text-center"]}>
  <p class="font-display text-xs uppercase tracking-[0.42em] text-relic">{eyebrow}</p>
  <h2 class="mt-4 font-display text-3xl text-mist sm:text-4xl lg:text-5xl">{title}</h2>
  {text && <p class="mt-5 text-lg leading-8 text-stone/82">{text}</p>}
</div>
