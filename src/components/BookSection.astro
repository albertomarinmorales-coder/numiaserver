---
interface Book {
  title: string;
  paragraphs: string[];
  list?: string[];
}

interface Props {
  book: Book;
  index: number;
}

const { book, index } = Astro.props;
const numeral = String(index + 1).padStart(2, "0");
---

<article class="ritual-border rounded-[2rem] p-6 sm:p-8 lg:p-10">
  <div class="grid gap-8 lg:grid-cols-[12rem_1fr]">
    <aside>
      <p class="font-display text-xs uppercase tracking-[0.4em] text-relic">Libro {numeral}</p>
      <div class="mt-5 hidden h-px bg-gradient-to-r from-relic/60 to-transparent lg:block"></div>
    </aside>

    <div>
      <h2 class="font-display text-3xl text-mist sm:text-4xl">{book.title}</h2>
      <div class="mt-7 space-y-5 text-lg leading-9 text-stone/86">
        {book.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {
        book.list && (
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {book.list.map((item) => (
              <li class="rounded-2xl border border-relic/15 bg-relic/[0.045] px-4 py-3 text-sm uppercase tracking-[0.16em] text-mist/86">
                {item}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
