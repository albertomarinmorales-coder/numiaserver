---
import BaseLayout from "@layouts/BaseLayout.astro";
import { dogmaVerses, dogmaPillars, project } from "@data/lore";

// Build verse pages (4 verses each)
const VERSES_PER_PAGE = 4;
const versePages: string[][] = [];
for (let i = 0; i < dogmaVerses.length; i += VERSES_PER_PAGE) {
  versePages.push(dogmaVerses.slice(i, i + VERSES_PER_PAGE));
}
// 24 verses → 6 verse pages

// Build spreads (left | right)
// Spread 0: title page | versePages[0]
// Spread 1: versePages[1] | versePages[2]
// Spread 2: versePages[3] | versePages[4]
// Spread 3: versePages[5] | colophon
const totalSpreads = 4;
---

<BaseLayout
  title={`Dogma | ${project.name}`}
  description="El Libro de la Estabilidad: dogma doctrinal de la Sociedad en forma de grimorio de páginas volubles."
>
  <!-- Pre-book header -->
  <section class="px-5 pb-4 pt-16 text-center sm:px-8 sm:pt-20">
    <p class="font-display text-[10px] uppercase tracking-[0.54em] text-relic/72">
      ✦ &ensp; Doctrina interna de la Sociedad &ensp; ✦
    </p>
    <h1 class="mt-4 font-display text-4xl text-mist sm:text-5xl">
      El Libro de la Estabilidad
    </h1>
    <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-stone/60">
      Navega los versículos fundacionales que sostienen el orden del mundo.
    </p>
  </section>

  <!-- ══════════════════════════════════════════════════════
       BOOK
  ══════════════════════════════════════════════════════ -->
  <section class="book-section px-4 py-10 sm:px-6 sm:py-14" aria-label="Grimorio del Dogma">
    <div class="book-outer mx-auto max-w-6xl">

      <!-- ── SPREAD 0: Title | versePages[0] ── -->
      <div class="book-spread" data-spread="0" aria-label="Apertura del grimorio">

        <!-- Left: Title page -->
        <div class="book-page book-page--left" aria-label="Portada interior">
          <div class="page-header">
            <span class="page-eyebrow">In nomine Stabilitatis</span>
          </div>
          <div class="title-block">
            <h2 class="font-display text-3xl text-mist sm:text-4xl">El Libro de<br/>la Estabilidad</h2>
            <div class="title-rule" aria-hidden="true"></div>
          </div>
          <!-- Central sigil -->
          <div class="title-sigil" aria-hidden="true">
            <div class="sigil-ring sigil-ring--outer"></div>
            <div class="sigil-ring sigil-ring--mid"></div>
            <div class="sigil-ring sigil-ring--diamond"></div>
            <div class="sigil-ring sigil-ring--inner animate-slow-pulse"></div>
            <span class="sigil-glyph">⬡</span>
          </div>
          <div class="page-footer">
            <span class="page-number">I</span>
          </div>
        </div>

        <!-- Spine -->
        <div class="book-spine" aria-hidden="true">
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
        </div>

        <!-- Right: Verses 1-4 -->
        <div class="book-page book-page--right" aria-label="Versículos I — IV">          <div class="page-header">
            <span class="page-eyebrow">De la naturaleza anterior</span>
          </div>
          <div class="verse-list">
            {versePages[0].map((verse, i) => (
              <div class="verse-entry">
                <span class="verse-num">{String(i + 1).padStart(2, "0")}</span>
                <p class="verse-text">{verse}</p>
              </div>
            ))}
          </div>
          <div class="page-footer">
            <span class="page-number">II</span>
          </div>
        </div>
      </div>

      <!-- ── SPREAD 1: versePages[1] | versePages[2] ── -->
      <div class="book-spread" data-spread="1" aria-hidden="true" style="display:none" aria-label="Versículos V — XII">

        <!-- Left: Verses 5-8 -->
        <div class="book-page book-page--left" aria-label="Versículos V — VIII">          <div class="page-header">
            <span class="page-eyebrow">De la comprensión del Salvador</span>
          </div>
          <div class="verse-list">
            {versePages[1].map((verse, i) => (
              <div class="verse-entry">
                <span class="verse-num">{String(i + 5).padStart(2, "0")}</span>
                <p class="verse-text">{verse}</p>
              </div>
            ))}
          </div>
          <div class="page-footer">
            <span class="page-number">III</span>
          </div>
        </div>

        <!-- Spine -->
        <div class="book-spine" aria-hidden="true">
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
        </div>

        <!-- Right: Verses 9-12 -->
        <div class="book-page book-page--right" aria-label="Versículos IX — XII">          <div class="page-header">
            <span class="page-eyebrow">Del origen de los Sellos</span>
          </div>
          <div class="verse-list">
            {versePages[2].map((verse, i) => (
              <div class="verse-entry">
                <span class="verse-num">{String(i + 9).padStart(2, "0")}</span>
                <p class="verse-text">{verse}</p>
              </div>
            ))}
          </div>
          <div class="page-footer">
            <span class="page-number">IV</span>
          </div>
        </div>
      </div>

      <!-- ── SPREAD 2: versePages[3] | versePages[4] ── -->
      <div class="book-spread" data-spread="2" aria-hidden="true" style="display:none" aria-label="Versículos XIII — XX">

        <!-- Left: Verses 13-16 -->
        <div class="book-page book-page--left" aria-label="Versículos XIII — XVI">          <div class="page-header">
            <span class="page-eyebrow">De los cuatro primeros Sellos</span>
          </div>
          <div class="verse-list">
            {versePages[3].map((verse, i) => (
              <div class="verse-entry">
                <span class="verse-num">{String(i + 13).padStart(2, "0")}</span>
                <p class="verse-text">{verse}</p>
              </div>
            ))}
          </div>
          <div class="page-footer">
            <span class="page-number">V</span>
          </div>
        </div>

        <!-- Spine -->
        <div class="book-spine" aria-hidden="true">
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
        </div>

        <!-- Right: Verses 17-20 -->
        <div class="book-page book-page--right" aria-label="Versículos XVII — XX">          <div class="page-header">
            <span class="page-eyebrow">De la Calibración y la Elevación</span>
          </div>
          <div class="verse-list">
            {versePages[4].map((verse, i) => (
              <div class="verse-entry">
                <span class="verse-num">{String(i + 17).padStart(2, "0")}</span>
                <p class="verse-text">{verse}</p>
              </div>
            ))}
          </div>
          <div class="page-footer">
            <span class="page-number">VI</span>
          </div>
        </div>
      </div>

      <!-- ── SPREAD 3: versePages[5] | Colophon ── -->
      <div class="book-spread" data-spread="3" aria-hidden="true" style="display:none" aria-label="Versículos XXI — XXIV y colofón">

        <!-- Left: Verses 21-24 -->
        <div class="book-page book-page--left" aria-label="Versículos XXI — XXIV">          <div class="page-header">
            <span class="page-eyebrow">De la permanencia final</span>
          </div>
          <div class="verse-list">
            {versePages[5].map((verse, i) => (
              <div class="verse-entry">
                <span class="verse-num">{String(i + 21).padStart(2, "0")}</span>
                <p class="verse-text">{verse}</p>
              </div>
            ))}
          </div>
          <div class="page-footer">
            <span class="page-number">VII</span>
          </div>
        </div>

        <!-- Spine -->
        <div class="book-spine" aria-hidden="true">
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
          <span class="spine-line"></span>
          <span class="spine-dot"></span>
        </div>

        <!-- Right: Colophon -->
        <div class="book-page book-page--right" aria-label="Colofón: Los cuatro pilares">          <div class="page-header">
            <span class="page-eyebrow">Los cuatro pilares</span>
          </div>
          <div class="pillar-list">
            {dogmaPillars.map((pillar, i) => (
              <div class="pillar-entry">
                <span class="pillar-num">{["I","II","III","IV"][i]}</span>
                <div>
                  <h3 class="pillar-title">{pillar.title}</h3>
                  <p class="pillar-text">{pillar.text}</p>
                </div>
              </div>
            ))}
          </div>
          <blockquote class="colophon-quote">
            "Y así permanecerá mientras la numia recuerde que no puede volver a ser lo que era antes del orden."
          </blockquote>
          <div class="page-footer">
            <span class="page-number">VIII</span>
          </div>
        </div>
      </div>

      <!-- ── Navigation ── -->
      <nav class="book-nav" aria-label="Navegación del grimorio">
        <button
          id="prev-btn"
          class="nav-btn nav-btn--prev"
          disabled
          aria-label="Página anterior"
        >
          <span aria-hidden="true">←</span>
          <span class="nav-label">Anterior</span>
        </button>

        <div class="nav-counter" aria-live="polite">
          <span id="spread-current">1</span>
          <span class="nav-sep">·</span>
          <span id="spread-total">{totalSpreads}</span>
        </div>

        <button
          id="next-btn"
          class="nav-btn nav-btn--next"
          aria-label="Página siguiente"
        >
          <span class="nav-label">Siguiente</span>
          <span aria-hidden="true">→</span>
        </button>
      </nav>
    </div>
  </section>
</BaseLayout>

<!-- ── Book-specific styles ── -->
<style>
  /* ---- Section & outer shell ---- */
  .book-section {
    background: radial-gradient(ellipse at 50% 50%, rgba(110, 231, 216, 0.04), transparent 68%);
  }

  .book-outer {
    box-shadow:
      -28px 28px 72px rgba(0, 0, 0, 0.88),
      28px 28px 72px rgba(0, 0, 0, 0.88),
      0 0 100px rgba(110, 231, 216, 0.04),
      0 0 60px rgba(198, 161, 91, 0.03);
  }

  /* ---- Spread: two pages + spine ---- */
  .book-spread {
    display: grid;
    grid-template-columns: 1fr 6px 1fr;
    min-height: 640px;
    transition: opacity 380ms ease, transform 380ms ease;
  }

  .book-spread.is-leaving {
    opacity: 0;
    transform: scale(0.985);
    pointer-events: none;
  }

  .book-spread.is-entering {
    opacity: 0;
    transform: scale(0.985);
  }

  /* ---- Individual page ---- */
  .book-page {
    position: relative;
    padding: 2.5rem 2rem 2rem;
    background: linear-gradient(160deg, #131008 0%, #0e0c09 100%);
    border: 1px solid rgba(198, 161, 91, 0.13);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Subtle noise on pages */
  .book-page::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 140px 140px;
    opacity: 0.038;
    mix-blend-mode: overlay;
    z-index: 0;
  }

  /* Everything above the noise */
  .book-page > * {
    position: relative;
    z-index: 1;
  }

  /* Binding shadow: pages curve inward toward the spine */
  .book-page--left {
    border-right: none;
    box-shadow: inset -18px 0 36px rgba(0, 0, 0, 0.62);
  }

  .book-page--right {
    border-left: none;
    box-shadow: inset 18px 0 36px rgba(0, 0, 0, 0.62);
  }

  /* ---- Spine / binding ---- */
  .book-spine {
    background: linear-gradient(180deg, #1a1408 0%, #0d0b06 50%, #1a1408 100%);
    border-top: 1px solid rgba(198, 161, 91, 0.12);
    border-bottom: 1px solid rgba(198, 161, 91, 0.12);
    box-shadow:
      inset 2px 0 8px rgba(0, 0, 0, 0.7),
      inset -2px 0 8px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 1.5rem 0;
  }

  .spine-dot {
    display: block;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: rgba(198, 161, 91, 0.5);
    flex-shrink: 0;
  }

  .spine-line {
    display: block;
    width: 1px;
    flex: 1;
    background: linear-gradient(180deg, transparent, rgba(198, 161, 91, 0.22), transparent);
  }

  /* ---- Corner marks ---- */
  /* ---- Page header ---- */
  .page-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(198, 161, 91, 0.14);
    margin-bottom: 1.75rem;
  }

  .page-header::before,
  .page-header::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(198, 161, 91, 0.24), transparent);
  }

  .page-eyebrow {
    font-family: "Marcellus", serif;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.44em;
    color: rgba(198, 161, 91, 0.62);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ---- Page footer with page number ---- */
  .page-footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(198, 161, 91, 0.1);
    display: flex;
    justify-content: center;
  }

  .page-number {
    font-family: "Cormorant Garamond", serif;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    color: rgba(198, 161, 91, 0.44);
  }

  /* ---- Title page elements ---- */
  .title-sigil {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 11rem;
    margin: 0.5rem 0 1.5rem;
    flex-shrink: 0;
  }

  .sigil-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid;
  }

  .sigil-ring--outer { width: 8.5rem; height: 8.5rem; border-color: rgba(110, 231, 216, 0.1); }
  .sigil-ring--mid   { width: 5.5rem; height: 5.5rem; border-color: rgba(198, 161, 91, 0.18); }
  .sigil-ring--diamond {
    width: 3.5rem; height: 3.5rem;
    border-radius: 0;
    transform: rotate(45deg);
    border-color: rgba(110, 231, 216, 0.14);
  }
  .sigil-ring--inner {
    width: 2.2rem; height: 2.2rem;
    background: rgba(110, 231, 216, 0.07);
    border-color: rgba(110, 231, 216, 0.3);
  }

  .sigil-glyph {
    position: relative;
    font-family: "Marcellus", serif;
    font-size: 1.5rem;
    color: rgba(110, 231, 216, 0.7);
    text-shadow: 0 0 20px rgba(110, 231, 216, 0.5);
  }

  .title-block {
    text-align: center;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
  }

  .title-rule {
    width: 4rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(198, 161, 91, 0.6), transparent);
    margin: 0.25rem auto;
  }

  /* ---- Verse list ---- */
  .verse-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .verse-entry {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .verse-num {
    font-family: "Marcellus", serif;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: rgba(198, 161, 91, 0.52);
    padding-top: 0.35rem;
  }

  .verse-text {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.8;
    color: rgba(215, 255, 250, 0.82);
  }

  /* ---- Pillar list (colophon) ---- */
  .pillar-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pillar-entry {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.75rem;
    align-items: start;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(198, 161, 91, 0.1);
  }

  .pillar-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pillar-num {
    font-family: "Marcellus", serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: rgba(198, 161, 91, 0.6);
    padding-top: 0.25rem;
  }

  .pillar-title {
    font-family: "Marcellus", serif;
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: rgba(215, 255, 250, 0.9);
    margin-bottom: 0.25rem;
  }

  .pillar-text {
    font-family: "Alegreya", serif;
    font-size: 0.88rem;
    line-height: 1.7;
    color: rgba(148, 163, 184, 0.75);
  }

  .colophon-quote {
    font-family: "Cormorant Garamond", serif;
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.8;
    color: rgba(198, 161, 91, 0.64);
    border-top: 1px solid rgba(198, 161, 91, 0.12);
    padding-top: 1rem;
    margin-top: 0.75rem;
  }

  /* ---- Navigation ---- */
  .book-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: rgba(10, 9, 6, 0.92);
    border: 1px solid rgba(198, 161, 91, 0.12);
    border-top: none;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Marcellus", serif;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: rgba(198, 161, 91, 0.7);
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .nav-btn:hover:not(:disabled) {
    color: rgba(198, 161, 91, 1);
    border-color: rgba(198, 161, 91, 0.28);
    background: rgba(198, 161, 91, 0.05);
  }

  .nav-btn:disabled {
    opacity: 0.28;
    cursor: not-allowed;
  }

  .nav-label {
    display: none;
  }

  @media (min-width: 480px) {
    .nav-label { display: inline; }
  }

  .nav-counter {
    font-family: "Cormorant Garamond", serif;
    font-size: 1rem;
    letter-spacing: 0.16em;
    color: rgba(148, 163, 184, 0.5);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  #spread-current {
    color: rgba(198, 161, 91, 0.75);
    font-size: 1.15rem;
  }

  .nav-sep {
    color: rgba(198, 161, 91, 0.3);
  }

  /* ---- Mobile: stack pages vertically ---- */
  @media (max-width: 767px) {
    .book-spread {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      min-height: unset;
    }

    .book-page--left {
      box-shadow: none;
      border-bottom: none;
      border-right: 1px solid rgba(198, 161, 91, 0.13);
    }

    .book-page--right {
      box-shadow: none;
      border-top: none;
      border-left: 1px solid rgba(198, 161, 91, 0.13);
    }

    .book-spine {
      flex-direction: row;
      height: 6px;
      width: 100%;
      padding: 0 1.5rem;
      gap: 0;
      border-top: none;
      border-bottom: none;
      border-left: 1px solid rgba(198, 161, 91, 0.12);
      border-right: 1px solid rgba(198, 161, 91, 0.12);
    }

    .spine-line {
      width: auto;
      height: 1px;
      flex: 1;
      background: linear-gradient(90deg, transparent, rgba(198, 161, 91, 0.22), transparent);
    }
  }
</style>

<!-- ── Book navigation script ── -->
<script>
  const spreads = document.querySelectorAll<HTMLElement>("[data-spread]");
  const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
  const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
  const spreadCurrent = document.getElementById("spread-current")!;
  const total = spreads.length;

  let current = 0;

  function goTo(next: number) {
    if (next < 0 || next >= total) return;

    const leaving = spreads[current];
    const entering = spreads[next];

    // Animate out
    leaving.classList.add("is-leaving");

    setTimeout(() => {
      leaving.style.display = "none";
      leaving.setAttribute("aria-hidden", "true");
      leaving.classList.remove("is-leaving");

      // Show entering
      entering.style.display = "grid";
      entering.setAttribute("aria-hidden", "false");
      entering.classList.add("is-entering");

      // Force reflow so transition fires
      entering.getBoundingClientRect();

      entering.classList.remove("is-entering");
      current = next;

      spreadCurrent.textContent = String(current + 1);
      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === total - 1;

      // Scroll to top of book
      document.querySelector(".book-outer")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }, 360);
  }

  prevBtn.addEventListener("click", () => goTo(current - 1));
  nextBtn.addEventListener("click", () => goTo(current + 1));

  // Keyboard navigation
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight" || e.key === "ArrowDown") goTo(current + 1);
    if (e.key === "ArrowLeft"  || e.key === "ArrowUp")   goTo(current - 1);
  });
</script>
