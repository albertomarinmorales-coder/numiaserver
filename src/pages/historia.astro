---
import BaseLayout from "@layouts/BaseLayout.astro";
import { historyBooks, project } from "@data/lore";

const total = historyBooks.length;
---

<BaseLayout
  title={`Historia | ${project.name}`}
  description="El Libro de la Estabilidad: historia oficial de la Sociedad, narrada capítulo a capítulo desde el Gran Equilibrio hasta la Promesa del Retorno."
>
  <!-- ══════════════════════════════════════════════════════
       READER — viewport-height, no inter-chapter scroll
  ══════════════════════════════════════════════════════ -->
  <div class="reader" role="main" aria-label="Lector de la Historia">

    <!-- ── Sidebar timeline ── -->
    <aside class="reader-sidebar" aria-label="Índice de capítulos">
      <div class="sidebar-header">
        <p class="sidebar-label">El Libro de la Estabilidad</p>
      </div>

      <!-- Track line -->
      <div class="timeline-track" aria-hidden="true">
        <div id="track-fill" class="timeline-fill" style="height: 0%"></div>
      </div>

      <!-- Chapter buttons -->
      <nav class="chapter-list-nav">
        {
          historyBooks.map((book, i) => (
            <button
              class:list={["chapter-btn", i === 0 && "is-active"]}
              data-chapter-btn={i}
              aria-label={`Ir al Libro ${book.roman}: ${book.title}`}
              aria-current={i === 0 ? "true" : undefined}
              style={`--gem-base:${book.gem.base};--gem-glow:${book.gem.glow};--gem-bg:${book.gem.bg};--gem-subtle:${book.gem.subtle}`}
            >
              <span class="chapter-dot" aria-hidden="true">
                <span class="chapter-dot-inner"></span>
              </span>
              <span class="chapter-btn-text">
                <span class="btn-roman">Libro {book.roman}</span>
                <span class="btn-short">{book.shortTitle}</span>
              </span>
            </button>
          ))
        }
      </nav>
    </aside>

    <!-- ── Content ── -->
    <div class="reader-content">

      {
        historyBooks.map((book, i) => (
          <article
            class:list={["chapter-panel", i === 0 && "is-active"]}
            data-chapter={i}
            aria-hidden={i !== 0 ? "true" : undefined}
            style={`--gem-base:${book.gem.base};--gem-glow:${book.gem.glow};--gem-bg:${book.gem.bg};--gem-subtle:${book.gem.subtle}`}
          >
            <!-- Header -->
            <header class="chapter-header">
              <div class="chapter-header-inner">
                <span class="chapter-roman" aria-hidden="true">
                  {book.roman}
                </span>
                <div>
                  <p class="chapter-eyebrow">Libro {book.roman}</p>
                  <h2 class="chapter-title">{book.title}</h2>
                </div>
              </div>
              <!-- Progress bar inside header -->
              <div class="chapter-progress-bar" aria-hidden="true">
                <div
                  class="chapter-progress-fill"
                  style={`width: ${((i + 1) / total) * 100}%`}
                ></div>
              </div>
            </header>

            <!-- Scrollable body -->
            <div class="chapter-body" tabindex="0">
              {book.paragraphs.map((para, pi) => (
                <p class:list={[pi === 0 && "dropcap"]}>{para}</p>
              ))}

              {book.list && (
                <ul class="chapter-roster">
                  {book.list.map((item) => (
                    <li class="roster-item">{item}</li>
                  ))}
                </ul>
              )}
            </div>

            <!-- Sticky image column -->
            <div class="chapter-image-col" aria-hidden="true">
              <div class="chapter-img-placeholder">
                <span class="img-corner img-corner--tl"></span>
                <span class="img-corner img-corner--tr"></span>
                <span class="img-corner img-corner--bl"></span>
                <span class="img-corner img-corner--br"></span>
                <div class="img-gem-content">
                  <span class="img-gem-glyph">◆</span>
                  <span class="img-gem-name">{book.gem.name}</span>
                </div>
              </div>
            </div>

            <!-- Chapter nav -->
            <nav class="chapter-nav" aria-label={`Navegación capítulo ${i + 1}`}>
              <button
                class="nav-btn"
                data-dir="prev"
                disabled={i === 0 || undefined}
                aria-label="Capítulo anterior"
              >
                <span aria-hidden="true">←</span>
                <span class="nav-btn-label">Anterior</span>
              </button>

              <div class="nav-info" aria-live="polite">
                <span class="nav-current">{i + 1}</span>
                <span class="nav-sep" aria-hidden="true">·</span>
                <span class="nav-total">{total}</span>
              </div>

              <button
                class="nav-btn"
                data-dir="next"
                disabled={i === total - 1 || undefined}
                aria-label="Capítulo siguiente"
              >
                <span class="nav-btn-label">Siguiente</span>
                <span aria-hidden="true">→</span>
              </button>
            </nav>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<!-- ════════════════════════════════════════════════════════
     STYLES (scoped to this page)
════════════════════════════════════════════════════════ -->
<style>
  /* ---- Overall reader layout ---- */
  .reader {
    display: grid;
    grid-template-columns: 260px 1fr;
    height: calc(100dvh - 65px); /* full viewport minus navbar */
    overflow: hidden;
    background: #09080a;
  }

  /* ── Sidebar ── */
  .reader-sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1.75rem 1.25rem 2rem 1.75rem;
    border-right: 1px solid rgba(198, 161, 91, 0.11);
    background: rgba(7, 6, 4, 0.95);
    scrollbar-width: thin;
    scrollbar-color: rgba(198, 161, 91, 0.18) transparent;
  }

  .sidebar-header {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(198, 161, 91, 0.1);
    margin-bottom: 1.5rem;
    flex-shrink: 0;
  }

  .sidebar-label {
    font-family: "Marcellus", serif;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.44em;
    color: rgba(198, 161, 91, 0.52);
  }

  /* Vertical track line */
  .timeline-track {
    position: absolute;
    left: 1.9rem; /* slightly left of the dot edge */
    top: 6.5rem;
    bottom: 2rem;
    width: 1px;
    background: rgba(198, 161, 91, 0.1);
    pointer-events: none;
  }

  .timeline-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(
      180deg,
      rgba(110, 231, 216, 0.7),
      rgba(198, 161, 91, 0.5)
    );
    transition: height 400ms ease;
    border-radius: 1px;
  }

  /* Nav container */
  .chapter-list-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    position: relative;
    z-index: 1;
  }

  /* Each chapter button */
  .chapter-btn {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.6rem 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    width: 100%;
    border-radius: 3px;
    transition: background 180ms ease;
  }

  .chapter-btn:hover {
    background: rgba(198, 161, 91, 0.04);
  }

  /* Dot */
  .chapter-dot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    margin-top: 0.3rem;
  }

  .chapter-dot-inner {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgba(148, 163, 184, 0.3);
    background: rgba(9, 8, 10, 0.95);
    transition: border-color 300ms, background 300ms, box-shadow 300ms;
  }

  .chapter-btn.is-active .chapter-dot-inner {
    border-color: var(--gem-base);
    background: var(--gem-bg);
    box-shadow: 0 0 10px var(--gem-glow), 0 0 4px var(--gem-base);
  }

  .chapter-btn.is-done .chapter-dot-inner {
    border-color: var(--gem-base);
    background: var(--gem-subtle);
    opacity: 0.55;
  }

  /* Button text */
  .chapter-btn-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .btn-roman {
    font-family: "Marcellus", serif;
    font-size: 0.56rem;
    text-transform: uppercase;
    letter-spacing: 0.36em;
    color: rgba(148, 163, 184, 0.45);
    transition: color 200ms;
  }

  .btn-short {
    font-family: "Alegreya", serif;
    font-size: 0.875rem;
    line-height: 1.35;
    color: rgba(148, 163, 184, 0.6);
    transition: color 200ms;
  }

  .chapter-btn.is-active .btn-roman {
    color: var(--gem-base);
    opacity: 0.85;
  }

  .chapter-btn.is-active .btn-short {
    color: rgba(215, 255, 250, 0.92);
  }

  .chapter-btn.is-done .btn-short {
    color: rgba(148, 163, 184, 0.72);
  }

  /* ── Content area ── */
  .reader-content {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: linear-gradient(150deg, #0f0d09 0%, #09080a 100%);
  }

  /* ── Chapter panels ── */
  .chapter-panel {
    display: none;
    grid-template-columns: 1fr 360px;
    grid-template-rows: auto 1fr auto;
    flex: 1;
    overflow: hidden;
  }

  .chapter-panel.is-active {
    display: grid;
  }

  .chapter-header {
    grid-column: 1 / -1;
  }

  .chapter-nav {
    grid-column: 1 / -1;
  }

  .chapter-panel.is-entering {
    animation: slideIn 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .chapter-panel.is-leaving {
    animation: slideOut 280ms ease-in both;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(16px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideOut {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(-10px); }
  }

  /* ── Chapter header ── */
  .chapter-header {
    flex-shrink: 0;
    padding: 1.75rem 2.5rem 1.25rem;
    border-bottom: 1px solid rgba(198, 161, 91, 0.1);
    background: rgba(7, 6, 4, 0.45);
    border-top: 2px solid var(--gem-base);
  }

  .chapter-header-inner {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .chapter-roman {
    font-family: "Cormorant Garamond", serif;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--gem-base);
    opacity: 0.35;
    flex-shrink: 0;
    margin-top: -0.15rem;
    user-select: none;
  }

  .chapter-eyebrow {
    font-family: "Marcellus", serif;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.46em;
    color: rgba(198, 161, 91, 0.58);
    margin-bottom: 0.3rem;
  }

  .chapter-title {
    font-family: "Marcellus", serif;
    font-size: clamp(1.4rem, 2.2vw, 2.1rem);
    line-height: 1.2;
    color: rgba(215, 255, 250, 0.94);
  }

  /* Thin progress bar below the title */
  .chapter-progress-bar {
    margin-top: 1rem;
    height: 2px;
    background: rgba(198, 161, 91, 0.08);
    border-radius: 1px;
    overflow: hidden;
  }

  .chapter-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gem-base), var(--gem-glow));
    border-radius: 1px;
    transition: width 400ms ease;
  }

  /* ── Scrollable body ── */
  .chapter-body {
    grid-column: 1;
    grid-row: 2;
    overflow-y: auto;
    min-height: 0;
    padding: 2rem 2.5rem 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(198, 161, 91, 0.2) transparent;
  }

  .chapter-body:focus {
    outline: none;
  }

  .chapter-body p {
    font-family: "Alegreya", serif;
    font-size: 1.1rem;
    line-height: 1.9;
    color: rgba(205, 216, 219, 0.84);
    max-width: 70ch;
    margin-bottom: 1.35rem;
  }

  /* ── Sticky image column ── */
  .chapter-image-col {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.25rem 1.5rem 0.75rem;
    overflow: hidden;
  }

  .chapter-img-placeholder {
    width: 100%;
    flex: 1;
    min-height: 0;
    background:
      radial-gradient(ellipse at 50% 35%, var(--gem-subtle) 0%, transparent 65%),
      rgba(7, 6, 4, 0.85);
    border: 1px solid var(--gem-base);
    box-shadow: inset 0 0 40px var(--gem-subtle), 0 0 20px var(--gem-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    opacity: 0.9;
  }

  /* Corner marks */
  .img-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--gem-base);
    border-style: solid;
    opacity: 0.6;
  }
  .img-corner--tl { top: 6px; left: 6px;  border-width: 1px 0 0 1px; }
  .img-corner--tr { top: 6px; right: 6px; border-width: 1px 1px 0 0; }
  .img-corner--bl { bottom: 6px; left: 6px;  border-width: 0 0 1px 1px; }
  .img-corner--br { bottom: 6px; right: 6px; border-width: 0 1px 1px 0; }

  .img-gem-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .img-gem-glyph {
    font-size: 2.5rem;
    color: var(--gem-base);
    opacity: 0.35;
    user-select: none;
    filter: drop-shadow(0 0 8px var(--gem-base));
  }

  .img-gem-name {
    font-family: "Marcellus", serif;
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5em;
    color: var(--gem-base);
    opacity: 0.45;
    user-select: none;
  }

  /* Drop cap on first paragraph */
  .chapter-body p.dropcap::first-letter {
    float: left;
    font-family: "Cormorant Garamond", serif;
    font-size: 4em;
    font-weight: 700;
    line-height: 0.78;
    margin-right: 0.18em;
    margin-top: 0.06em;
    color: rgba(198, 161, 91, 0.82);
  }

  /* Roster list (Seis Sellos) */
  .chapter-roster {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 52ch;
  }

  .roster-item {
    font-family: "Alegreya", serif;
    font-size: 1rem;
    color: rgba(215, 255, 250, 0.76);
    padding: 0.55rem 1rem;
    border: 1px solid rgba(198, 161, 91, 0.1);
    background: rgba(198, 161, 91, 0.025);
    list-style: none;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .roster-item::before {
    content: "◆";
    font-size: 0.45rem;
    color: rgba(198, 161, 91, 0.5);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* ── Navigation bar ── */
  .chapter-nav {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 2.5rem;
    border-top: 1px solid rgba(198, 161, 91, 0.09);
    background: rgba(5, 4, 3, 0.7);
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Marcellus", serif;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(198, 161, 91, 0.65);
    padding: 0.45rem 0.75rem;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: color 200ms, border-color 200ms, background 200ms;
  }

  .nav-btn:hover:not([disabled]) {
    color: rgba(198, 161, 91, 1);
    border-color: rgba(198, 161, 91, 0.26);
    background: rgba(198, 161, 91, 0.04);
  }

  .nav-btn[disabled] {
    opacity: 0.22;
    cursor: not-allowed;
  }

  .nav-btn-label {
    display: none;
  }

  @media (min-width: 520px) {
    .nav-btn-label { display: inline; }
  }

  .nav-info {
    font-family: "Cormorant Garamond", serif;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    color: rgba(148, 163, 184, 0.42);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-current {
    font-size: 1.1rem;
    color: rgba(198, 161, 91, 0.7);
  }

  .nav-sep {
    color: rgba(198, 161, 91, 0.3);
  }

  /* ══════════════════════════════════════════
     MOBILE: horizontal scrollable tab rail
  ══════════════════════════════════════════ */
  @media (max-width: 767px) {
    .reader {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: auto;
      max-height: none;
      overflow: visible;
    }

    .reader-sidebar {
      border-right: none;
      border-bottom: 1px solid rgba(198, 161, 91, 0.11);
      flex-direction: row;
      align-items: center;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0.75rem 1rem;
      gap: 0.25rem;
      height: auto;
      min-height: 3.5rem;
    }

    .sidebar-header {
      display: none;
    }

    .timeline-track {
      display: none;
    }

    .chapter-list-nav {
      flex-direction: row;
      gap: 0.25rem;
    }

    .chapter-btn {
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      padding: 0.4rem 0.75rem;
      min-width: auto;
      white-space: nowrap;
    }

    .chapter-dot {
      margin-top: 0;
    }

    .btn-short {
      display: none;
    }

    .btn-roman {
      font-size: 0.6rem;
    }

    /* On mobile, panels need explicit height */
    .reader-content {
      height: calc(100dvh - 65px - 56px); /* viewport - navbar - tab rail */
      overflow: hidden;
    }

    .chapter-panel.is-active {
      display: flex;
      flex-direction: column;
    }

    .chapter-image-col {
      display: none;
    }

    .chapter-body {
      grid-column: unset;
      grid-row: unset;
    }

    .chapter-header {
      grid-column: unset;
    }

    .chapter-nav {
      grid-column: unset;
    }

    .chapter-header {
      padding: 1.25rem 1.25rem 1rem;
    }

    .chapter-roman {
      font-size: 2rem;
    }

    .chapter-body {
      padding: 1.25rem 1.25rem 1rem;
    }

    .chapter-nav {
      padding: 0.75rem 1.25rem;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .reader {
      grid-template-columns: 210px 1fr;
    }

    .chapter-panel {
      grid-template-columns: 1fr 220px;
    }

    .chapter-header {
      padding: 1.5rem 2rem 1.1rem;
    }

    .chapter-body {
      padding: 1.5rem 2rem;
    }

    .chapter-nav {
      padding: 0.875rem 2rem;
    }
  }
</style>

<!-- ════════════════════════════════════════════════════════
     SCRIPT
════════════════════════════════════════════════════════ -->
<script>
  const TOTAL = document.querySelectorAll("[data-chapter]").length;

  const panels       = Array.from(document.querySelectorAll<HTMLElement>("[data-chapter]"));
  const sidebarBtns  = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-chapter-btn]"));
  const trackFill    = document.getElementById("track-fill") as HTMLElement;

  let current = 0;

  /* ---- Update UI to reflect chapter index ---- */
  function setChapter(next: number, direction: "fwd" | "back" = "fwd") {
    if (next === current || next < 0 || next >= TOTAL) return;

    const leaving  = panels[current];
    const entering = panels[next];

    // Animate out current panel, then switch
    leaving.classList.add("is-leaving");

    leaving.addEventListener("animationend", () => {
      leaving.classList.remove("is-active", "is-leaving");
      leaving.setAttribute("aria-hidden", "true");

      entering.classList.add("is-active", "is-entering");
      entering.removeAttribute("aria-hidden");
      entering.querySelector<HTMLElement>(".chapter-body")?.scrollTo({ top: 0 });

      entering.addEventListener("animationend", () => {
        entering.classList.remove("is-entering");
      }, { once: true });

      current = next;
      syncSidebar();
    }, { once: true });
  }

  /* ---- Sync sidebar state and track fill ---- */
  function syncSidebar() {
    sidebarBtns.forEach((btn, i) => {
      btn.classList.toggle("is-active", i === current);
      btn.classList.toggle("is-done", i < current);
      btn.setAttribute("aria-current", i === current ? "true" : "false");
    });

    // Measure the actual vertical center of the active dot relative to the track
    const track = document.querySelector<HTMLElement>(".timeline-track");
    const activeDot = sidebarBtns[current]?.querySelector<HTMLElement>(".chapter-dot");

    if (track && activeDot) {
      const trackRect  = track.getBoundingClientRect();
      const dotRect    = activeDot.getBoundingClientRect();
      const dotCenterY = dotRect.top + dotRect.height / 2;
      const pct = Math.max(0, Math.min(100,
        ((dotCenterY - trackRect.top) / trackRect.height) * 100
      ));
      trackFill.style.height = `${pct}%`;
    }

    // Scroll active button into view on mobile rail
    sidebarBtns[current]?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
  }

  /* ---- Sidebar button clicks ---- */
  sidebarBtns.forEach((btn, i) => {
    btn.addEventListener("click", () => setChapter(i, i > current ? "fwd" : "back"));
  });

  /* ---- Prev/Next nav buttons (inside each panel) ---- */
  document.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panel = btn.closest<HTMLElement>("[data-chapter]")!;
      const idx   = Number(panel.dataset.chapter);
      const dir   = btn.dataset.dir as "prev" | "next";
      setChapter(dir === "next" ? idx + 1 : idx - 1, dir === "next" ? "fwd" : "back");
    });
  });

  /* ---- Keyboard navigation ---- */
  document.addEventListener("keydown", (e) => {
    const tag = (document.activeElement as HTMLElement)?.tagName;
    // Don't hijack when typing in inputs or focused on scrollable body
    if (tag === "TEXTAREA" || tag === "INPUT") return;
    if ((document.activeElement as HTMLElement)?.classList.contains("chapter-body")) return;

    if (e.key === "ArrowRight") setChapter(current + 1, "fwd");
    if (e.key === "ArrowLeft")  setChapter(current - 1, "back");
  });

  // Initial sync
  syncSidebar();

  // Recalculate fill on resize (dot positions may shift)
  window.addEventListener("resize", syncSidebar, { passive: true });
</script>
